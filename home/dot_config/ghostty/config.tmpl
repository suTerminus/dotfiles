## ~/.config/ghostty/config
## managed by chezmoi via home/dot_config/ghostty/config.tmpl

# Font: Fira Code Nerd Font (installed via Phase 1 brew bundle).
font-family = FiraCode Nerd Font
font-size = 13

# Theme: native dark/light auto-switching follows macOS appearance.
theme = light:catppuccin-latte,dark:catppuccin-mocha

# UX.
window-padding-x = 8
window-padding-y = 4
window-decoration = true
copy-on-select = true
shell-integration = zsh

# Mouse.
mouse-hide-while-typing = true

# Keybind: Cmd+Shift+T to flip the system theme via theme-toggle.
keybind = super+shift+t=text:theme-toggle\n
