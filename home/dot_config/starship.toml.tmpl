palette = "catppuccin"

[directory]
style = "blue"
format = "[$path]($style)"
truncation_length = 3
truncate_to_repo = true
read_only = "  "

[directory.substitutions]
"~/code" = " code"
"Documents" = "󰈙 docs"
"Downloads" = " dl"
".config" = " config"

[git_branch]
symbol = " "
style = "subtext1"
format = '[ $symbol$branch]($style)'

[git_status]
style = "yellow"
format = '[$all_status]($style)'
modified = "*"
staged = "+"
untracked = "?"
stashed = '$'
deleted = "✘"
renamed = "»"
conflicted = "⚠"
ahead = "↑"
behind = "↓"
diverged = "↕"
up_to_date = ""

[kubernetes]
symbol = "󱃾 "
style = "mauve"
format = '[ $symbol$context(/$namespace)]($style)'
disabled = false
detect_files = ["k8s", "kustomization.yaml", "skaffold.yaml", "helmfile.yaml"]
detect_folders = [".kube", "charts"]
contexts = []

[nodejs]
symbol = " "
style = "subtext1"
format = '[ $symbol($version)]($style)'
detect_files = ["package.json", ".nvmrc", "tsconfig.json"]

[python]
symbol = " "
style = "subtext1"
format = '[ $symbol${pyenv_prefix}(${version} )(\($virtualenv\) )]($style)'
detect_files = ["pyproject.toml", "requirements.txt", "setup.py", "Pipfile"]

[golang]
symbol = " "
style = "subtext1"
format = '[ $symbol($version)]($style)'
detect_files = ["go.mod", "go.sum", "go.work"]

[rust]
symbol = " "
style = "subtext1"
format = '[ $symbol($version)]($style)'
detect_files = ["Cargo.toml"]

[java]
symbol = " "
style = "subtext1"
format = '[ $symbol($version)]($style)'
detect_files = ["pom.xml", "build.gradle", "build.gradle.kts"]

[battery]
disabled = false
format = '[ $symbol$percentage]($style)'
full_symbol = "󰁹"
charging_symbol = "󰂄"
discharging_symbol = "󰁾"
unknown_symbol = "󰁽"
empty_symbol = "󰂃"

[[battery.display]]
threshold = 25
style = "red"
discharging_symbol = "󰁻 "

[[battery.display]]
threshold = 50
style = "yellow"
discharging_symbol = "󰁾 "

[cmd_duration]
style = "overlay1"
format = '[ ⏱ $duration]($style)'
min_time = 2000
show_milliseconds = false

[line_break]
disabled = false

[character]
success_symbol = "[❯](bold green)"
error_symbol   = "[❯](bold red)"
vimcmd_symbol  = "[❮](bold mauve)"
