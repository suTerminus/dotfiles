## ~/.config/starship.toml
## managed by chezmoi via home/dot_config/starship.toml.tmpl
##
## Minimalist prompt. Lightly separated, only colored where something
## needs attention. Catppuccin palette auto-derives from ~/.theme-mode.
##
## Layout:
##   <path> <branch>(<dirty?>) <k8s ctx>/<ns> <battery if low> <duration if slow>
##   <❯>
##
## Reload after editing the source template via theme-toggle (which
## re-runs chezmoi apply).

{{- $themeMode := "dark" -}}
{{- if (stat (joinPath .chezmoi.homeDir ".theme-mode")) -}}
{{-   $themeMode = (output "cat" (joinPath .chezmoi.homeDir ".theme-mode")) | trim -}}
{{- end -}}

add_newline = true

format = """
$directory \
$git_branch\
$git_status\
$kubernetes\
$nodejs\
$python\
$golang\
$rust\
$java\
$battery\
$cmd_duration\
$line_break\
$character"""

# Catppuccin {{ $themeMode }} palette.
[palettes.catppuccin]
